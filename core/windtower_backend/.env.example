QWEN_API_KEY=
# Automatic policy: Qwen -> official DashScope; DeepSeek -> official DeepSeek;
# every other/foreign model -> N1N. Explicit profiles can override this.
# Credentials remain environment-only and are never written to experiment artifacts.
QWEN_PROVIDER_PROFILE=auto
QWEN_OFFICIAL_API_KEY=
QWEN_OFFICIAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_OFFICIAL_API_KEY=
DEEPSEEK_OFFICIAL_BASE_URL=https://api.deepseek.com
QWEN_N1N_API_KEY=
QWEN_N1N_BASE_URL=https://api.n1n.ai/v1
ENGINEERING_LLM_PROVIDER=qwen
QWEN_MODEL=qwen3.8-max
QWEN_OCR_MODEL=qwen3.5-ocr
QWEN_VISION_MODEL=qwen3.7-max-2026-06-08
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEMPERATURE=0.7
QWEN_MAX_TOKENS=4000
QWEN_TIMEOUT=60
ABAQUS_CMD=C:\SIMULIA\Commands\abaqus.bat
WINDTOWER_BACKEND_HOST=127.0.0.1
WINDTOWER_BACKEND_PORT=8000
# Required before binding the backend to any non-loopback address.
# WINDTOWER_API_TOKEN=
WINDTOWER_UPLOAD_FILE_LIMIT_MB=50
WINDTOWER_UPLOAD_BATCH_LIMIT_MB=200
WINDTOWER_UPLOAD_UNPACKED_LIMIT_MB=500
WINDTOWER_UPLOAD_MAX_COMPRESSION_RATIO=100
WINDTOWER_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
# Local Abaqus execution is opt-in through the explicit solve API/UI action.
ABAQUS_CMD=C:\SIMULIA\Commands\abaqus.bat
ABAQUS_MAX_CONCURRENT_JOBS=2
ABAQUS_JOB_CPUS=1
ABAQUS_JOB_TIMEOUT_SECONDS=14400
ABAQUS_ODB_TIMEOUT_SECONDS=1800
ABAQUS_MIN_FREE_GB=5
# Desktop runtime roots are injected by Electron. They may also be set when
# testing the packaged backend without the desktop shell.
WINDTOWER_DESKTOP_MODE=0
# WINDTOWER_DESKTOP_TOKEN=
# WINDTOWER_DATA_ROOT=C:\Users\you\AppData\Local\WindTowerCAE\data
# WINDTOWER_WORK_ROOT=C:\Users\you\AppData\Local\WindTowerCAE\work\abaqus
# WINDTOWER_LOG_ROOT=C:\Users\you\AppData\Local\WindTowerCAE\logs
# WINDTOWER_CACHE_ROOT=C:\Users\you\AppData\Local\WindTowerCAE\cache
# WINDTOWER_CONFIG_ROOT=C:\Users\you\AppData\Roaming\WindTowerCAE\config
# ABAQUS_COMMAND=C:\SIMULIA\Commands\abaqus.bat
